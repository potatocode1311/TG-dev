<?xml version="1.0" encoding="utf-8"?>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".MainActivity">



            <Button
                android:id="@+id/newGame"
                android:layout_width="117dp"
                android:layout_height="47dp"
                android:layout_marginStart="75dp"
                android:text="New Game"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <Button
                android:id="@+id/nextRound"
                android:layout_width="116dp"
                android:layout_height="55dp"
                android:layout_marginTop="96dp"
                android:text="Next Round"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.464"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/addTeam"
                android:layout_width="117dp"
                android:layout_height="47dp"
                android:layout_marginStart="75dp"
                android:layout_marginTop="50dp"
                android:text="Add Team"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/addPoints"
                android:layout_width="117dp"
                android:layout_height="47dp"
                android:layout_marginEnd="100dp"
                android:text="+ Points"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/subtractPoints"
                android:layout_width="117dp"
                android:layout_height="47dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="100dp"
                android:text="- Points"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/addPoints" />

    <Button
        android:id="@+id/confirmTeam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Team"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/teamInputContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/teamInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.997">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/teamInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:hint="Team Name" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/teamsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="168dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp"></LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>



